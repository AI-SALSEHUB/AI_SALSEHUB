# A copier sur le VPS : /opt/saleshub/.env  (chmod 600) -- NE JAMAIS COMMITER
APP_NAME=SalesHub
APP_ENV=production
APP_KEY=            # IDENTIQUE a l'ancien .env (donnees chiffrees)
APP_DEBUG=false
APP_URL=https://ai.saleshub.business
ACME_EMAIL=tonny.andritina@gmail.com

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=saleshub
DB_USERNAME=saleshub
DB_PASSWORD=          # nouveau mot de passe fort
DB_ROOT_PASSWORD=     # nouveau mot de passe fort

REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_DOMAIN=ai.saleshub.business
SANCTUM_STATEFUL_DOMAINS=ai.saleshub.business

# + reprendre du .env actuel (valeurs ROTATEES) : MAIL_*, GOOGLE_*, OPENAI/ANTHROPIC/GEMINI,
#   MAXMIND, PAPPERS, DROPCONTACT, MINDEE, etc.  -- SANS aucune variable telephonie (SignalWire/SIP/Kavkom/FreeSWITCH)
